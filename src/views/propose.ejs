<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
  <title>💖 The Question</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Dancing+Script:wght@400;600;700&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Lora', Georgia, serif;
      min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      padding: 24px; margin: 0;
      background: linear-gradient(145deg, #ffe9ec 0%, #fcd5e1 40%, #fbc4d5 100%);
      overflow: hidden; position: relative;
    }

    #confetti-canvas {
      position: fixed; top: 0; left: 0;
      width: 100%; height: 100%;
      pointer-events: none; z-index: 100; display: none;
    }

    .proposal-card {
      position: relative; z-index: 10;
      background: rgba(255, 248, 245, 0.92);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-radius: 48px;
      padding: 44px 32px;
      max-width: 420px; width: 100%;
      text-align: center;
      box-shadow: 0 30px 80px rgba(180, 80, 110, 0.25);
      border: 1px solid rgba(255, 255, 255, 0.6);
      animation: fadeSlideUp 0.6s ease forwards;
      transition: all 0.3s ease;
    }

    @keyframes fadeSlideUp {
      0% { opacity: 0; transform: translateY(30px) scale(0.96); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    .ring-icon {
      font-size: 64px; display: block; margin-bottom: 12px;
      animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.1); }
    }

    h1 {
      font-family: 'Playfair Display', Georgia, serif;
      color: #3d2a3d; font-size: 30px; font-weight: 700;
      margin-bottom: 8px; line-height: 1.2;
    }

    .sub {
      font-family: 'Lora', Georgia, serif;
      color: #b0808a; font-size: 15px;
      margin-bottom: 32px; font-style: italic;
    }

    .btn-group {
      display: flex; gap: 20px;
      flex-wrap: wrap; justify-content: center;
      align-items: center; min-height: 120px;
      position: relative;
    }

    .btn-accept {
      font-family: 'Playfair Display', Georgia, serif;
      padding: 20px 40px;
      background: linear-gradient(135deg, #f5a0b0, #e87a9a);
      border: none; border-radius: 60px;
      color: white; font-size: 24px; font-weight: 700;
      cursor: pointer;
      box-shadow: 0 8px 30px rgba(232, 122, 154, 0.4);
      transition: all 0.3s ease;
      letter-spacing: 0.5px; min-width: 140px; flex-shrink: 0;
    }

    .btn-accept:active { transform: scale(0.95); }

    .btn-accept.growing { animation: growPulse 0.5s ease; }

    @keyframes growPulse {
      0% { transform: scale(1); }
      50% { transform: scale(1.1); }
      100% { transform: scale(1); }
    }

    .btn-reject {
      font-family: 'Lora', Georgia, serif;
      padding: 16px 32px;
      background: rgba(200, 180, 190, 0.3);
      border: 2px solid rgba(200, 180, 190, 0.4);
      border-radius: 60px;
      color: #6a4a5a; font-size: 17px; font-weight: 600;
      cursor: pointer; transition: all 0.3s ease;
      min-width: 100px; flex-shrink: 0;
      user-select: none; touch-action: none;
      position: relative; font-style: italic;
    }

    .btn-reject:active { transform: scale(0.92); }
    .btn-reject.shrinking { transform: scale(0.7) !important; opacity: 0.6; }
    .btn-reject.tiny { transform: scale(0.3) !important; opacity: 0.2; pointer-events: none; }

    .think-again {
      font-family: 'Dancing Script', cursive;
      color: #d45a7a; font-size: 20px; font-weight: 700;
      margin-top: 16px; min-height: 30px;
      opacity: 0; transition: opacity 0.4s ease;
    }

    .think-again.show { opacity: 1; }

    .celebration {
      display: none; margin-top: 28px; padding-top: 24px;
      border-top: 2px dashed rgba(200, 150, 160, 0.25);
      animation: revealUp 0.8s ease forwards;
    }

    .celebration.show { display: block; }

    @keyframes revealUp {
      0% { opacity: 0; transform: translateY(30px) scale(0.9); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    .celebration h2 {
      font-family: 'Dancing Script', cursive;
      color: #d45a7a; font-size: 42px;
      margin-bottom: 10px; font-weight: 700;
    }

    .celebration .romantic-message {
      background: linear-gradient(135deg, rgba(232, 114, 138, 0.1), rgba(245, 160, 176, 0.1));
      border-radius: 24px; padding: 24px; margin-top: 12px;
      border: 2px solid rgba(232, 114, 138, 0.2);
    }

    .celebration .romantic-message p {
      font-family: 'Lora', Georgia, serif;
      color: #3d2a3d; font-size: 16px;
      line-height: 1.8; font-weight: 400;
    }

    .celebration .romantic-message .big {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 22px; color: #d45a7a;
      font-weight: 700; line-height: 1.4;
    }

    .celebration .love-you {
      font-family: 'Dancing Script', cursive;
      font-size: 34px; color: #d45a7a;
      font-weight: 700; margin-top: 20px;
    }

    .logout-link {
      font-family: 'Lora', Georgia, serif;
      display: block; margin-top: 24px; font-size: 11px;
      color: #b895a5; text-decoration: none;
      opacity: 0.3; transition: 0.2s;
    }

    .logout-link:hover { opacity: 1; }

    /* ===== MUSIC PLAYING INDICATOR ===== */
    .music-indicator {
      position: fixed;
      bottom: 24px; right: 24px;
      z-index: 9999;
      background: rgba(255, 248, 245, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-radius: 60px;
      padding: 10px 20px 10px 18px;
      display: flex; align-items: center; gap: 12px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.4);
      pointer-events: none; user-select: none;
    }

    .eq-bars {
      display: flex; align-items: flex-end; gap: 3px; height: 20px;
    }

    .eq-bars span {
      display: block; width: 3px;
      background: linear-gradient(180deg, #f5a0b0, #e87a9a);
      border-radius: 3px;
      animation: eqAnim 1s ease-in-out infinite;
    }

    .eq-bars span:nth-child(1) { height: 40%; animation-delay: 0s; }
    .eq-bars span:nth-child(2) { height: 80%; animation-delay: 0.2s; }
    .eq-bars span:nth-child(3) { height: 60%; animation-delay: 0.4s; }
    .eq-bars span:nth-child(4) { height: 90%; animation-delay: 0.1s; }

    @keyframes eqAnim {
      0%, 100% { transform: scaleY(0.5); }
      50% { transform: scaleY(1); }
    }

    .music-indicator-text {
      display: flex; flex-direction: column; align-items: flex-start;
    }

    .music-indicator-text .label {
      font-family: 'Dancing Script', cursive;
      font-size: 15px; color: #b0808a; font-weight: 700;
      letter-spacing: 0.3px;
    }

    .music-progress-track {
      width: 50px; height: 3px;
      background: rgba(200, 150, 160, 0.2);
      border-radius: 10px; margin-top: 2px; overflow: hidden;
    }

    #musicProgress {
      width: 0%; height: 100%;
      background: linear-gradient(90deg, #f5a0b0, #e87a9a);
      border-radius: 10px; transition: width 0.3s;
    }

    @media (max-width: 420px) {
      .proposal-card { padding: 32px 20px; }
      h1 { font-size: 25px; }
      .btn-accept { font-size: 20px; padding: 16px 28px; min-width: 120px; }
      .btn-reject { font-size: 15px; padding: 14px 24px; min-width: 80px; }
      .celebration h2 { font-size: 34px; }
      .celebration .love-you { font-size: 28px; }
    }
  </style>
</head>
<body>

  <canvas id="confetti-canvas"></canvas>

  <div class="proposal-card" id="proposalCard">

    <span class="ring-icon">💍</span>
    <h1>The Big Question</h1>
    <p class="sub">Niki, I've said everything I feel.</p>

    <div class="btn-group" id="btnGroup">
      <button class="btn-accept" id="btnAccept"> Yes</button>
      <button class="btn-reject" id="btnReject"> Reject</button>
    </div>

    <div class="think-again" id="thinkAgain">
      Hmm... are you sure? Think again, beautiful.
    </div>

    <div class="celebration" id="celebration">
      <h2>She said Yes!</h2>
      <div class="romantic-message">
        <p>
          <span class="big">💖 You just made me the happiest person alive.</span><br /><br />
          Niki, I promise to always be by your side.<br />
          I promise to make you laugh, to hold your hand, and to love you with everything I have.<br /><br />
          <span style="font-family: 'Playfair Display', serif; font-size: 18px; color: #d45a7a; font-style: italic;">This is just the beginning of our story. 💫</span>
        </p>
      </div>
      <p class="love-you">I love you, Niki ❤️</p>
    </div>

    <a href="/logout" class="logout-link">↺ Logout</a>
  </div>

  <!-- ===== MUSIC PLAYING INDICATOR ===== -->
  <div class="music-indicator">
    <div class="eq-bars">
      <span></span><span></span><span></span><span></span>
    </div>
    <div class="music-indicator-text">
      <span class="label">🎵 Our Song</span>
      <div class="music-progress-track">
        <div id="musicProgress"></div>
      </div>
    </div>
  </div>

  <audio id="bgMusic" src="/music/background.mp3" loop></audio>

  <script>
    (function() {

      // ---- MUSIC PLAYER (un-pausable) ----
      const audio = document.getElementById('bgMusic');
      const progressBar = document.getElementById('musicProgress');

      const savedTime = sessionStorage.getItem('bgMusicTime');
      if (savedTime) {
        audio.currentTime = parseFloat(savedTime);
      }

      audio.addEventListener('timeupdate', function() {
        if (audio.duration) {
          const percent = (audio.currentTime / audio.duration) * 100;
          progressBar.style.width = percent + '%';
        }
        if (Math.floor(audio.currentTime) % 2 === 0) {
          sessionStorage.setItem('bgMusicTime', audio.currentTime);
        }
      });

      window.addEventListener('beforeunload', function() {
        sessionStorage.setItem('bgMusicTime', audio.currentTime);
      });

      function startMusic() {
        audio.play().catch(function(err) { console.log('Autoplay blocked:', err); });
      }

      document.addEventListener('click', startMusic, { once: true });
      document.addEventListener('touchstart', startMusic, { once: true });
      document.addEventListener('keydown', startMusic, { once: true });

      audio.addEventListener('pause', function() {
        if (!document.hidden) {
          audio.play().catch(function(){});
        }
      });

      console.log('🎵 Music will play continuously. No stopping!');

      // ---- BUTTONS ----
      const btnAccept = document.getElementById('btnAccept');
      const btnReject = document.getElementById('btnReject');
      const thinkAgain = document.getElementById('thinkAgain');
      const celebration = document.getElementById('celebration');
      const btnGroup = document.getElementById('btnGroup');

      let rejectClicks = 0;

      function moveRejectButton() {
        const groupRect = btnGroup.getBoundingClientRect();
        const btnRect = btnReject.getBoundingClientRect();

        const padding = 10;
        const maxX = groupRect.width - btnRect.width - padding;
        const maxY = groupRect.height - btnRect.height - padding;

        if (maxX > 0 && maxY > 0) {
          const randomX = Math.random() * maxX;
          const randomY = Math.random() * maxY;
          btnReject.style.position = 'relative';
          btnReject.style.left = randomX + 'px';
          btnReject.style.top = randomY + 'px';
          btnReject.style.transition = 'left 0.25s ease, top 0.25s ease';
        }
      }

      function handleRejectClick(e) {
        e.preventDefault();
        rejectClicks++;

        if (rejectClicks === 1) {
          btnReject.classList.add('shrinking');
          btnReject.textContent = '😅 Still no?';
          thinkAgain.classList.add('show');
        } else if (rejectClicks === 2) {
          btnReject.classList.add('tiny');
          btnReject.textContent = '😭';
          thinkAgain.textContent = 'Okay but... I\'ll keep asking until you say yes.';
        } else if (rejectClicks >= 3) {
          btnReject.style.display = 'none';
          thinkAgain.textContent = 'Looks like you have no choice but to say YES. 💖';
        }

        btnAccept.classList.remove('growing');
        void btnAccept.offsetWidth;
        btnAccept.classList.add('growing');

        const currentSize = parseFloat(window.getComputedStyle(btnAccept).fontSize) || 24;
        const newSize = currentSize + 6;
        btnAccept.style.fontSize = Math.min(newSize, 52) + 'px';
        btnAccept.style.padding = (20 + rejectClicks * 4) + 'px ' + (40 + rejectClicks * 4) + 'px';

        moveRejectButton();

        btnReject.style.transform = 'scale(0.7) rotate(-5deg)';
        setTimeout(() => {
          btnReject.style.transform = 'scale(0.7) rotate(5deg)';
        }, 100);
        setTimeout(() => {
          btnReject.style.transform = 'scale(0.7) rotate(0deg)';
        }, 200);
      }

      btnAccept.addEventListener('click', function() {
        celebration.classList.add('show');

        setTimeout(() => {
          celebration.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 200);

        fireConfetti();

        btnAccept.disabled = true;
        btnAccept.textContent = ' Already Said Yes!';
        btnAccept.style.opacity = '0.7';

        btnReject.disabled = true;
        btnReject.style.opacity = '0.3';
        btnReject.textContent = ' Too late!';
      });

      btnReject.addEventListener('mouseenter', function(e) {
        if (rejectClicks < 3 && !btnReject.disabled) {
          moveRejectButton();
        }
      });

      btnReject.addEventListener('click', handleRejectClick);
      btnReject.addEventListener('touchstart', function(e) {
        e.preventDefault();
        handleRejectClick(e);
      });

      // ---- CONFETTI ENGINE ----
      const canvas = document.getElementById('confetti-canvas');
      const ctx = canvas.getContext('2d');
      let particles = [];
      let animationId = null;

      function resizeCanvas() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      }
      window.addEventListener('resize', resizeCanvas);
      resizeCanvas();

      class Particle {
        constructor() {
          this.x = Math.random() * canvas.width;
          this.y = Math.random() * canvas.height - canvas.height;
          this.size = Math.random() * 12 + 4;
          this.speedY = Math.random() * 5 + 2;
          this.speedX = (Math.random() - 0.5) * 4;
          this.color = `hsl(${Math.random() * 60 + 330}, 80%, 60%)`;
          this.rotation = 0;
          this.rotationSpeed = (Math.random() - 0.5) * 0.1;
          this.shape = Math.random() > 0.5 ? 'rect' : 'circle';
        }

        update() {
          this.y += this.speedY;
          this.x += this.speedX;
          this.rotation += this.rotationSpeed;
          this.speedX += (Math.random() - 0.5) * 0.05;

          if (this.y > canvas.height + 50) {
            this.y = -50;
            this.x = Math.random() * canvas.width;
            this.speedY = Math.random() * 5 + 2;
            this.speedX = (Math.random() - 0.5) * 4;
          }
        }

        draw() {
          ctx.save();
          ctx.translate(this.x, this.y);
          ctx.rotate(this.rotation);
          ctx.fillStyle = this.color;

          if (this.shape === 'rect') {
            ctx.fillRect(-this.size / 2, -this.size / 4, this.size, this.size / 2);
          } else {
            ctx.beginPath();
            ctx.arc(0, 0, this.size / 2, 0, Math.PI * 2);
            ctx.fill();
          }

          ctx.restore();
        }
      }

      function fireConfetti() {
        canvas.style.display = 'block';

        for (let i = 0; i < 300; i++) {
          particles.push(new Particle());
        }

        if (animationId) cancelAnimationFrame(animationId);

        function animate() {
          ctx.clearRect(0, 0, canvas.width, canvas.height);

          for (let i = particles.length - 1; i >= 0; i--) {
            const p = particles[i];
            p.update();
            p.draw();

            if (p.y > canvas.height + 100) {
              particles.splice(i, 1);
            }
          }

          if (particles.length < 200 && Math.random() > 0.3) {
            particles.push(new Particle());
          }

          if (particles.length === 0) {
            canvas.style.display = 'none';
            return;
          }

          animationId = requestAnimationFrame(animate);
        }

        animate();

        setTimeout(() => {
          if (animationId) {
            cancelAnimationFrame(animationId);
            animationId = null;
          }
          particles = [];
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          canvas.style.display = 'none';
        }, 10000);
      }

    })();
  </script>

</body>
</html>