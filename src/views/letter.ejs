<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes" />
  <title>💖 My Confession</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Dancing+Script:wght@400;600;700&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Lora', Georgia, serif;
      min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      padding: 20px; margin: 0;
      background: linear-gradient(145deg, #ffe9ec 0%, #fcd5e1 40%, #fbc4d5 100%);
      overflow-x: hidden; position: relative;
    }

    #hearts-container {
      position: fixed; top: 0; left: 0;
      width: 100%; height: 100%;
      pointer-events: none; z-index: 0; overflow: hidden;
    }

    .heart {
      position: absolute; bottom: -20px;
      font-size: 20px; opacity: 0.6;
      animation: floatUp linear infinite;
      user-select: none; color: #e8728a;
      text-shadow: 0 0 10px rgba(232, 114, 138, 0.3);
    }

    @keyframes floatUp {
      0% { transform: translateY(0) rotate(0deg) scale(1); opacity: 0.6; }
      100% { transform: translateY(-110vh) rotate(720deg) scale(0.2); opacity: 0; }
    }

    .flip-container {
      position: relative; z-index: 1;
      width: 100%; max-width: 400px;
      perspective: 1200px;
    }

    .flip-inner {
      position: relative; width: 100%;
      padding-bottom: 155%;
      transition: transform 0.8s cubic-bezier(0.23, 1, 0.32, 1);
      transform-style: preserve-3d; cursor: pointer;
    }

    .flip-inner.flipped { transform: rotateY(180deg); }

    .flip-front, .flip-back {
      position: absolute; top: 0; left: 0;
      width: 100%; height: 100%;
      backface-visibility: hidden;
      border-radius: 48px;
      overflow-y: auto;
      padding: 32px 24px;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      box-shadow: 0 30px 80px rgba(180, 80, 110, 0.25), 0 10px 30px rgba(0, 0, 0, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.6);
    }

    .flip-front {
      background: rgba(255, 248, 245, 0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transform: rotateY(0deg);
      text-align: center;
    }

    .photo-frame {
      width: 65%; max-width: 200px;
      aspect-ratio: 3 / 4;
      border-radius: 20px; overflow: hidden;
      border: 6px solid rgba(255, 255, 255, 0.95);
      box-shadow: 0 16px 50px rgba(200, 100, 130, 0.3), 0 4px 12px rgba(0, 0, 0, 0.06);
      margin-bottom: 28px;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      animation: floatPhoto 4s ease-in-out infinite;
    }

    .photo-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }

    @keyframes floatPhoto {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-8px); }
    }

    .flip-front:hover .photo-frame {
      transform: scale(1.02);
      box-shadow: 0 20px 60px rgba(200, 100, 130, 0.4);
    }

    .flip-front h2 {
      font-family: 'Dancing Script', cursive;
      color: #3d2a3d; font-size: 34px; font-weight: 700;
      margin-bottom: 6px; letter-spacing: 0.5px;
    }

    .tap-hint {
      font-family: 'Lora', Georgia, serif;
      color: #b0808a; font-size: 14px; font-weight: 400;
      font-style: italic;
      background: rgba(232, 114, 138, 0.08);
      padding: 8px 24px; border-radius: 60px;
      border: 1px solid rgba(232, 114, 138, 0.12);
      position: relative; overflow: hidden;
    }

    .tap-hint::after {
      content: '';
      position: absolute; top: -50%; left: -60%;
      width: 200%; height: 200%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
      transform: rotate(25deg);
      animation: shimmer 3s infinite;
    }

    @keyframes shimmer {
      0% { transform: translateX(-100%) rotate(25deg); }
      100% { transform: translateX(100%) rotate(25deg); }
    }

    .flip-back {
      background: rgba(255, 248, 245, 0.95);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      transform: rotateY(180deg);
      justify-content: flex-start;
      padding: 30px 22px; text-align: left;
      overflow-y: auto;
    }

    .flip-back::-webkit-scrollbar { width: 3px; }
    .flip-back::-webkit-scrollbar-thumb { background: #e87a9a; border-radius: 10px; }

    .flip-back .badge {
      font-family: 'Dancing Script', cursive;
      display: inline-block;
      background: linear-gradient(135deg, #f5a0b0, #e87a9a);
      color: white; font-size: 18px; font-weight: 700;
      letter-spacing: 0.5px;
      padding: 2px 20px 6px 20px;
      border-radius: 60px; margin-bottom: 12px;
      box-shadow: 0 4px 15px rgba(232, 122, 154, 0.3);
      align-self: flex-start;
    }

    .flip-back h1 {
      font-family: 'Playfair Display', Georgia, serif;
      color: #3d2a3d; font-size: 24px; font-weight: 700;
      margin-bottom: 4px; align-self: flex-start; line-height: 1.3;
    }

    .flip-back .sub-head {
      font-family: 'Lora', Georgia, serif;
      color: #b0808a; font-size: 14px; font-weight: 400;
      margin-bottom: 16px; font-style: italic;
      border-bottom: 1px solid rgba(200, 150, 160, 0.2);
      padding-bottom: 12px; width: 100%;
    }

    .flip-back .letter-body p {
      font-family: 'Lora', Georgia, serif;
      color: #4a344a; font-size: 14.5px; line-height: 1.85;
      margin-bottom: 13px; font-weight: 400;
    }

    .flip-back .letter-body strong { color: #d45a7a; font-weight: 600; }

    .flip-back .highlight-box {
      background: rgba(232, 114, 138, 0.07);
      border-radius: 16px; padding: 14px 18px;
      margin: 14px 0; border-left: 4px solid #e87a9a; width: 100%;
    }

    .flip-back .highlight-box p {
      margin-bottom: 0; font-size: 15px; font-weight: 500;
      color: #3d2a3d; font-style: italic;
      line-height: 1.8;
    }

    .flip-back .signature {
      text-align: right; margin-top: 16px; padding-top: 14px;
      border-top: 2px dashed rgba(200, 150, 160, 0.2); width: 100%;
    }

    .flip-back .signature p {
      font-family: 'Lora', Georgia, serif;
      font-size: 14px; font-weight: 400; font-style: italic;
      color: #b0808a; margin-bottom: 2px;
    }

    .flip-back .signature span {
      font-family: 'Dancing Script', cursive;
      font-size: 28px; color: #d45a7a; font-weight: 700;
    }

    .cta-group {
      display: flex; gap: 12px;
      margin-top: 18px; flex-wrap: wrap; width: 100%;
    }

    .btn-primary {
      font-family: 'Playfair Display', Georgia, serif;
      flex: 1; min-width: 120px; padding: 14px 20px;
      background: linear-gradient(135deg, #f5a0b0, #e87a9a);
      border: none; border-radius: 60px;
      color: white; font-weight: 600; font-size: 16px;
      text-align: center; text-decoration: none;
      box-shadow: 0 6px 25px rgba(232, 122, 154, 0.35);
      transition: 0.2s; cursor: pointer; letter-spacing: 0.3px;
    }

    .btn-primary:active { transform: scale(0.95); }

    .logout-link {
      font-family: 'Lora', Georgia, serif;
      display: block; margin-top: 18px; font-size: 11px;
      color: #b895a5; text-decoration: none;
      opacity: 0.4; transition: 0.2s; align-self: center;
    }

    .logout-link:hover { opacity: 1; }

    /* ===== MUSIC PLAYING INDICATOR ===== */
    .music-indicator {
      position: fixed;
      bottom: 24px; right: 24px;
      z-index: 9999;
      background: rgba(255, 248, 245, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-radius: 60px;
      padding: 10px 20px 10px 18px;
      display: flex; align-items: center; gap: 12px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.4);
      pointer-events: none; user-select: none;
    }

    .eq-bars {
      display: flex; align-items: flex-end; gap: 3px; height: 20px;
    }

    .eq-bars span {
      display: block; width: 3px;
      background: linear-gradient(180deg, #f5a0b0, #e87a9a);
      border-radius: 3px;
      animation: eqAnim 1s ease-in-out infinite;
    }

    .eq-bars span:nth-child(1) { height: 40%; animation-delay: 0s; }
    .eq-bars span:nth-child(2) { height: 80%; animation-delay: 0.2s; }
    .eq-bars span:nth-child(3) { height: 60%; animation-delay: 0.4s; }
    .eq-bars span:nth-child(4) { height: 90%; animation-delay: 0.1s; }

    @keyframes eqAnim {
      0%, 100% { transform: scaleY(0.5); }
      50% { transform: scaleY(1); }
    }

    .music-indicator-text {
      display: flex; flex-direction: column; align-items: flex-start;
    }

    .music-indicator-text .label {
      font-family: 'Dancing Script', cursive;
      font-size: 15px; color: #b0808a; font-weight: 700;
      letter-spacing: 0.3px;
    }

    .music-progress-track {
      width: 50px; height: 3px;
      background: rgba(200, 150, 160, 0.2);
      border-radius: 10px; margin-top: 2px; overflow: hidden;
    }

    #musicProgress {
      width: 0%; height: 100%;
      background: linear-gradient(90deg, #f5a0b0, #e87a9a);
      border-radius: 10px; transition: width 0.3s;
    }

    @media (max-width: 420px) {
      .flip-front .photo-frame { width: 55%; max-width: 150px; }
      .flip-front h2 { font-size: 28px; }
      .flip-back { padding: 24px 18px; }
      .flip-back h1 { font-size: 21px; }
      .flip-back .letter-body p { font-size: 13.5px; }
      .flip-inner { padding-bottom: 165%; }
      .flip-back .signature span { font-size: 24px; }
    }

    @media (max-width: 360px) {
      .flip-front .photo-frame { width: 50%; max-width: 120px; }
      .flip-back .letter-body p { font-size: 12.5px; line-height: 1.7; }
      .flip-inner { padding-bottom: 175%; }
    }
  </style>
</head>
<body>

  <div id="hearts-container"></div>

  <div class="flip-container">
    <div class="flip-inner" id="flipCard">

      <div class="flip-front">
        <div class="photo-frame">
          <img src="/images/her.png" alt="My Special Girl" />
        </div>
        <h2>My Niki</h2>
        <div class="tap-hint">👆 Tap to open my heart</div>
      </div>

      <div class="flip-back">
        <span class="badge">My Confession</span>
        <h1>I fell in love with you.</h1>
        <div class="sub-head">And I need to tell you why.</div>

        <div class="letter-body">
          <p>
            I don't know exactly when it happened.
          </p>
          <p>
            Maybe it was when we talked about our pasts with each other, and I realized how much you value clear communication. Even though I was tired with my own things, I felt comfort with you.
          </p>
          <p>
            All I know is that somewhere between our first conversation and now, you became the person I think about first in the morning and last at night.
          </p>

          <div class="highlight-box">
            <p>
              ✨ Being with you makes me feel at peace.<br />
              You inspire me to keep growing, even on the days I'm worn out.<br />
              With you, love feels simple and real.
            </p>
          </div>

          <p>
            We've shared so many dates together — each one special in its own way, each one making me feel closer to you.
          </p>
          <p>
            And yes, sometimes we've had misunderstandings or miscommunication. For those times, I don't want us to over-assume. I want us to clear things up with each other and build trust gradually, step by step.
          </p>
          <p>
            But I don't just want dates anymore.<br /><br />
            I want <strong>you</strong>. I want to be the reason you smile. I want to hold your hand and call you mine.
          </p>

          <p style="font-weight: 500; color: #d45a7a; font-size: 17px; margin-top: 10px; text-align: center;">
            So, Niki...<br />
            <strong style="font-size: 19px; font-family: 'Playfair Display', serif;">Will you be my girlfriend?</strong>
          </p>
        </div>

        <div class="signature">
          <p>All my heart,</p>
          <span>— Scott 💫</span>
        </div>

        <div class="cta-group">
          <a href="/propose" class="btn-primary">💖 Tell Me Your Answer →</a>
        </div>

        <a href="/logout" class="logout-link">↺ Logout (just in case)</a>
      </div>

    </div>
  </div>

  <!-- ===== MUSIC PLAYING INDICATOR ===== -->
  <div class="music-indicator">
    <div class="eq-bars">
      <span></span><span></span><span></span><span></span>
    </div>
    <div class="music-indicator-text">
      <span class="label">🎵 Our Song</span>
      <div class="music-progress-track">
        <div id="musicProgress"></div>
      </div>
    </div>
  </div>

  <audio id="bgMusic" src="/music/background.mp3" loop></audio>

  <script>
    // ----- FLOATING HEARTS -----
    (function createHearts() {
      const container = document.getElementById('hearts-container');
      const heartEmojis = ['❤️', '♥️', '💕', '💗', '✨', '🌸', '🩷'];
      const numberOfHearts = 40;

      for (let i = 0; i < numberOfHearts; i++) {
        const heart = document.createElement('div');
        heart.classList.add('heart');
        heart.textContent = heartEmojis[Math.floor(Math.random() * heartEmojis.length)];

        const size = Math.random() * 22 + 12;
        heart.style.fontSize = size + 'px';
        heart.style.left = Math.random() * 100 + '%';
        heart.style.animationDuration = (Math.random() * 14 + 10) + 's';
        heart.style.animationDelay = (Math.random() * 12) + 's';
        heart.style.opacity = Math.random() * 0.5 + 0.2;

        container.appendChild(heart);
      }
    })();

    // ----- FLIP CARD -----
    const flipCard = document.getElementById('flipCard');

    flipCard.addEventListener('click', function(e) {
      if (e.target.tagName === 'A') return;
      this.classList.toggle('flipped');
    });

    console.log('💖 Tap her portrait to reveal the confession!');

    // ----- MUSIC PLAYER (un-pausable) -----
    (function() {
      const audio = document.getElementById('bgMusic');
      const progressBar = document.getElementById('musicProgress');

      const savedTime = sessionStorage.getItem('bgMusicTime');
      if (savedTime) {
        audio.currentTime = parseFloat(savedTime);
      }

      audio.addEventListener('timeupdate', function() {
        if (audio.duration) {
          const percent = (audio.currentTime / audio.duration) * 100;
          progressBar.style.width = percent + '%';
        }
        if (Math.floor(audio.currentTime) % 2 === 0) {
          sessionStorage.setItem('bgMusicTime', audio.currentTime);
        }
      });

      window.addEventListener('beforeunload', function() {
        sessionStorage.setItem('bgMusicTime', audio.currentTime);
      });

      function startMusic() {
        audio.play().catch(function(err) { console.log('Autoplay blocked:', err); });
      }

      document.addEventListener('click', startMusic, { once: true });
      document.addEventListener('touchstart', startMusic, { once: true });
      document.addEventListener('keydown', startMusic, { once: true });

      audio.addEventListener('pause', function() {
        if (!document.hidden) {
          audio.play().catch(function(){});
        }
      });

      console.log('🎵 Music will play continuously. No stopping!');
    })();
  </script>

</body>
</html>